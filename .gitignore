# .gitignore — lixo de SO / editor. NAO ignore .claude/, meta/ nem logs/ (versionados de proposito).
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
# Segredos e capturas de rede: HAR e .env carregam cookie/token de sessao.
*.har
.env
.env.*
# Pacotes gerados da extensao.
*.zip
*.crx
*.pem
# Dependencias de desenvolvimento (jsdom, so para os testes).
node_modules/
